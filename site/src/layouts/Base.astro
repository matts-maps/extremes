---
interface Props { title: string; description?: string; bodyAttrs?: Record<string, string>; }
const { title, description, bodyAttrs = {} } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
{description && <meta name="description" content={description}>}
</head>
<body {...bodyAttrs}>
<slot />
</body>
</html>
