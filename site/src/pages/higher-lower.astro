---
import Base from '../layouts/Base.astro';
import SiteMenu from '../components/SiteMenu.astro';
import '../styles/game-base.css';
import '../styles/higher-or-lower.css';
---
<Base title="Higher or lower" bodyAttrs={{ "data-kind": "highest" }}>
<div class="wrap">
<header>
  <svg class="logo" viewBox="0 0 64 64" aria-hidden="true"><defs><linearGradient id="lg1" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffd27a"/><stop offset="1" stop-color="#ff6f61"/></linearGradient><linearGradient id="lg2" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4aa3e8"/><stop offset="1" stop-color="#0d2a40"/></linearGradient></defs><circle cx="32" cy="32" r="30" fill="#13283a" stroke="rgba(255,255,255,.2)"/><path d="M6 36 L24 10 L34 24 L40 16 L58 36Z" fill="url(#lg1)"/><path d="M6 36 H58 V42 Q50 50 32 50 Q14 50 6 42Z" fill="url(#lg2)"/><path d="M14 46 q4 -3 8 0 t8 0 t8 0 t8 0" fill="none" stroke="#bfe3ff" stroke-width="1.6" stroke-linecap="round"/></svg>
  <h1>Higher <span>or lower</span></h1>
  <SiteMenu current="higher-lower" />
</header>
<p class="sub">Which country has the highest point, the lowest point or the higher average elevation? Keep a streak going until you get one wrong. After each answer, both figures are shown against sea level and the dataset extremes.</p>

<div class="card" id="setup">
  <div class="modes" id="mode">
    <button class="mode on" data-m="highest"><svg viewBox="0 0 44 34"><path d="M2 32 L16 8 L24 20 L30 12 L42 32Z" fill="#ffb347"/><path d="M13 13 L16 8 L19 13 L16 12Z" fill="#fff"/></svg><b>Highest points</b><small>Peaks and plateaus</small></button>
    <button class="mode" data-m="lowest"><svg viewBox="0 0 44 34"><path d="M2 8 H42 V10 Q32 14 22 10 Q12 6 2 10Z" fill="#4aa3e8"/><path d="M2 12 L14 12 L22 30 L30 12 L42 12 V32 H2Z" fill="#35c2c9" opacity=".85"/></svg><b>Lowest points</b><small>Basins and shores</small></button>
    <button class="mode" data-m="average"><svg viewBox="0 0 44 34"><path d="M2 32 L12 16 L20 24 L28 10 L42 32Z" fill="#7bd88f" opacity=".85"/><path d="M2 20 H42" stroke="#fff" stroke-width="2" stroke-dasharray="4 3"/></svg><b>Average elevation</b><small>The whole country</small></button>
    <button class="mode" data-m="mixed"><svg viewBox="0 0 44 34"><path d="M2 20 L11 4 L18 14 L24 8 L32 20Z" fill="#ffb347"/><path d="M2 22 H42 V32 H2Z" fill="#4aa3e8"/><path d="M26 24 l6 6 l6 -6" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round"/></svg><b>Mixed</b><small>All three, at random</small></button>
  </div>
  <div class="row" style="margin-top:14px">
    <select id="region" aria-label="Region"><option value="">All regions</option></select>
    <div class="seg" id="units" role="group" aria-label="Units"><button data-u="metric">Metric (m)</button><button data-u="imperial">Imperial (ft)</button></div>
        <div class="pill" style="margin-left:auto"><span class="ic">🏆</span><div><b id="best">0</b> <span>best streak</span></div></div>
  </div>
  <div class="startrow"><button class="go" id="start">Start</button><p class="muted" id="poolnote"></p></div>
</div>

<div class="hud hidden" id="hud">
  <div class="pill"><span class="ic">🔥</span><div><b id="streak">0</b> <span>streak</span></div></div>
  <button class="pill" id="menu" style="color:var(--ink);font:inherit;cursor:pointer">☰ <span>Menu</span></button>
</div>

<div class="card hidden" id="play">
  <p class="q" id="question"></p>
  <p class="hint">Click a card, or press <kbd>1</kbd> or <kbd>2</kbd></p>
  <div class="choices"><button class="choice" id="c0"></button><div class="vs">VS</div><button class="choice" id="c1"></button></div>
</div>

<div class="card hidden" id="reveal">
  <div class="banner" id="banner"><div class="badge" id="badge"></div><div class="btxt"><p class="verdict" id="verdict"></p><p class="muted" id="gap"></p><p class="muted" id="endnote"></p></div><button class="go" id="next">Next</button></div>
  <div class="chartbox" id="chart"></div>
  <div class="cmp" id="cmp"></div>
</div>

<footer><div class="credit">Created by Fantail GIS (2026)</div></footer>
</div>
</Base>
<script>
  import '../scripts/higher-or-lower.js';
</script>
